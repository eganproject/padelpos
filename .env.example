PORT=4000
CLIENT_URL=http://localhost:3000
VENUE_TIMEZONE=Asia/Jakarta

# Database MySQL 8.0.19 atau lebih baru (lihat bagian Database di README). Wajib di produksi.
DATABASE_URL=mysql://padelix:ganti-password@127.0.0.1:3306/padelix
# Atau isi per bagian bila password mengandung karakter khusus:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=padelix
# MYSQL_PASSWORD=ganti-password
# MYSQL_DATABASE=padelix
# Jumlah koneksi MySQL per proses API (bawaan 10).
# DATABASE_POOL_SIZE=10
# Optional absolute directory; default: apps/api/data
# DATA_DIR=C:/padelix-data
# Required for initial admin setup in production, then remove it:
# BOOTSTRAP_TOKEN=replace-with-a-long-random-value
# Isi hanya bila ada reverse proxy (mis. nginx, Cloudflare) di depan Next.js yang menambahkan IP asli
# pengunjung ke X-Forwarded-For. Tanpa proxy, server web sudah meneruskan IP pengunjung ke API.
# TRUST_PROXY=loopback
# Kunci untuk meneruskan IP pengunjung dari server web ke API. Boleh kosong bila web dan API satu mesin:
# API membuat kunci acak di DATA_DIR/proxy-secret dan web membacanya. Isi bila keduanya beda mesin.
# INTERNAL_PROXY_SECRET=isi-string-acak-panjang

# Folder backup harian (bawaan: DATA_DIR/backups). Sebaiknya di disk lain atau folder yang disinkron.
# BACKUP_DIR=D:/padelix-backup
# Frontend proxy override (set in apps/web/.env.local or process environment):
# API_INTERNAL_URL=http://127.0.0.1:4000

# Pembayaran online Midtrans. Kunci boleh diisi lewat panel admin (menu Pembayaran); bila diisi di
# sini, nilai ini yang dipakai dan mengunci pilihan lingkungan di panel.
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# MIDTRANS_IS_PRODUCTION=false
# Alamat publik aplikasi; dipakai untuk URL webhook dan halaman kembali setelah membayar.
# Isi bila berbeda dari CLIENT_URL, mis. saat memakai terowongan ngrok.
# PUBLIC_URL=https://booking.venue-anda.com

# Notifikasi email lewat SMTP. Boleh diisi lewat panel admin (menu Notifikasi Email); bila SMTP_HOST
# diisi di sini, nilai environment yang dipakai.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=booking@venue-anda.com
# SMTP_PASS=app-password-gmail
# MAIL_FROM=booking@venue-anda.com
